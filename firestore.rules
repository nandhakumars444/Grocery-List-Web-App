rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /groceryItems/{itemId} {
      allow read, write: if true;
    }

    match /customTiles/{tileId} {
      allow read, write: if true;
    }

    match /purchaseHistory/{tripId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
